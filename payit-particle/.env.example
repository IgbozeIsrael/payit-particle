# PayIT Environment Configuration

# AI Model APIs
# Groq API for text processing and intent parsing
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA API for image generation (invoice visuals, business banners)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=@payiitbot
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_USE_WEBHOOK=false

# Auth Server URL (for social login)
AUTH_URL=http://localhost:3000/auth

# Blockchain Configuration
# Arbitrum Sepolia RPC Endpoint
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
INVOICE_FACTORY_ADDRESS=
# Platform fee wallet — all service fees route here (invoice fees, yield spread, etc.)
FEE_WALLET_ADDRESS=
TREASURY_ADDRESS=

# Wallet Configuration (OPTIONAL - Only needed for simulation mode)
# Master wallet private key for signing transactions (DO NOT commit to git)
# Not required when using Particle Network Universal Accounts in production
MASTER_WALLET_PRIVATE_KEY=

# Particle Network Configuration (for Universal Accounts)
# Get these from https://dashboard.particle.network
PARTICLE_PROJECT_ID=your_particle_project_id_here
PARTICLE_CLIENT_KEY=your_particle_client_key_here
PARTICLE_APP_UUID=your_particle_app_uuid_here

# Server Configuration
PORT=3000

# ZeroDev Configuration (Session Keys)
ZERODEV_PROJECT_ID=your_zerodev_project_id_here

# Openfort Configuration (Treasury TEE)
OPENFORT_SECRET_KEY=your_openfort_secret_key_here
OPENFORT_WALLET_SECRET=your_openfort_wallet_secret_here
OPENFORT_TREASURY_ACCOUNT_ID=your_openfort_account_id_here
OPENFORT_POLICY_ID=your_openfort_policy_id_here

# Magic.link Configuration (DID Auth)
MAGIC_PUBLISHABLE_KEY=your_magic_publishable_key_here
MAGIC_SECRET_KEY=your_magic_secret_key_here

# Nuvion Configuration (Banking API for BVN/CAC verification and virtual accounts)
NUVION_API_KEY=your_nuvion_api_key_here
NUVION_BASE_URL=https://api.nuvion.dev
